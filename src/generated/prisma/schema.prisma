generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isBlocked     Boolean        @default(false)
  avatar        String?
  hometown      String?
  phoneNumber   String?
  dateOfBirth   DateTime?      @db.Date
  cartItems     CartItem[]
  orders        Order[]
  refreshTokens RefreshToken[]
  couponUsages  CouponUsage[]

  @@map("user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]

  @@index([parentId])
  @@map("category")
}

model Product {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  deletedAt   DateTime?
  description String?
  price       Decimal        @db.Decimal(10, 2)
  stock       Int            @default(0)
  isPublished Boolean        @default(true)
  categoryId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  category    Category?      @relation(fields: [categoryId], references: [id])
  images      ProductImage[]

  @@index([categoryId])
  @@index([slug])
  @@map("product")
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  isMain    Boolean  @default(false)
  position  Int      @default(0)
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_image")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_item")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  productImage String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model Order {
  id     String @id @default(uuid())
  code   String @unique // Mã đơn hàng (ví dụ: ORD-123456)
  userId String

  // --- TÍNH TOÁN TIỀN ---
  subTotal       Decimal @db.Decimal(12, 2)
  shippingFee    Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  // --- KHUYẾN MÃI ---
  couponId    String?
  couponCode  String?
  coupon      Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponUsage CouponUsage?

  // --- THÔNG TIN THANH TOÁN & TRẠNG THÁI ---
  status               OrderStatus   @default(PENDING)
  paymentMethod        PaymentMethod @default(COD)
  isPaid               Boolean       @default(false)
  paidAt               DateTime?
  paymentTransactionId String?

  // --- HỦY ĐƠN HÀNG ---
  cancelReason String?
  cancelledBy  String?
  cancelledAt  DateTime?

  // --- THÔNG TIN GIAO HÀNG (GHN API) ---
  recipientName  String
  recipientPhone String
  provinceId     Int
  provinceName   String
  districtId     Int
  districtName   String
  wardCode       String
  wardName       String
  detailAddress  String
  weight         Int     @default(500)
  note           String?

  // --- VẬN CHUYỂN ---
  shippingProvider     String?   @default("GHN")
  trackingCode         String?
  expectedDeliveryDate DateTime?

  // --- TIMESTAMPS & RELATIONS ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId])
  @@index([code])
  @@index([couponId])
  @@index([trackingCode])
  @@map("orders")
}

model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique
  description String?
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)

  minOrderValue    Decimal? @db.Decimal(12, 2)
  maxDiscountValue Decimal? @db.Decimal(10, 2)

  usageLimit     Int?
  usedCount      Int  @default(0)
  userUsageLimit Int  @default(1)

  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  usages CouponUsage[]

  @@index([code])
  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  orderId  String   @unique
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, couponId])
  @@map("coupon_usages")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
}

enum CouponType {
  PERCENTAGE // Giảm theo % (VD: 10%, 20%)
  FIXED_AMOUNT // Giảm theo số tiền cố định (VD: 30.000 VNĐ)
  SHIPPING // Giảm phí vận chuyển (Freeship hoặc giảm bớt phí ship)
}
